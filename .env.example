# ---- Server ----
PORT=3000
DB_PATH=./data/upaj-sahyog.db
NODE_ENV=development

# ---- Aadhaar ----
# simulator | uidai | gateway
AADHAAR_PROVIDER=simulator
AADHAAR_HASH_SALT=change-me

# Live UIDAI Auth/e-KYC 2.5 (requires a UIDAI AUA/KUA licence + ASA/KSA network)
UIDAI_ASA_URL=https://<your-asa-endpoint>
UIDAI_AUA_CODE=
UIDAI_AUA_LICENSE_KEY=
UIDAI_ASA_LICENSE_KEY=
# HSM-backed service that builds the encrypted PID block and signs the auth XML
UIDAI_SIGNER_URL=

# Licensed KUA aggregator / UIDAI sandbox REST gateway
AADHAAR_GATEWAY_URL=
AADHAAR_GATEWAY_KEY=
AADHAAR_GATEWAY_CLIENT_ID=

# ---- Payments ----
# simulator | razorpay | cashfree
PAYMENT_PROVIDER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
